# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build outputs
build/
dist/
# vmsg.spec is tracked deliberately - it defines how official artifacts are
# packaged and should be reviewable. Only generated specs are ignored.
*.spec
!vmsg.spec

# Pytest / Coverage / Tooling
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv
venv/
ENV/
env/

# IDE & Editor settings
.vscode/
.idea/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Runtime persistent configuration
mappings.json
mappings.json.tmp

# TestController patch tool - downloaded CFR/ECJ jars, not our code
tools/tc-patch-tools/
TestController-patched.jar
TestController-scripted.jar
